{
  "name": "nervik",
  "version": "0.1.0",
  "private": true,
  "description": "Nervik — app del centro de control, API y página web B2B",
  "workspaces": ["api", "app", "simulador"],
  "scripts": {
    "dev": "concurrently -n api,app,web -c gray,blue,green \"npm run dev -w api\" \"npm run dev -w app\" \"npx --yes serve -l 8080 web\"",
    "dev:api": "npm run dev -w api",
    "dev:app": "npm run dev -w app",
    "dev:web": "npx --yes serve -l 8080 web",
    "simular": "npm start -w simulador",
    "test": "npm test -w api",
    "build": "npm run build -w app",
    "reiniciar-datos": "node -e \"require('fs').rmSync('api/datos',{recursive:true,force:true});require('fs').rmSync('simulador/.estado-simulador.json',{force:true});console.log('Datos de desarrollo borrados')\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": { "node": ">=22.13" }
}
